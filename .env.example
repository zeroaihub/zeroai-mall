# ===== AI Agent 接入所需环境变量（复制为 .env 后填入真实值，.env 不入库）=====

# --- 模型主通道：OpenAI 兼容协议（DeepSeek / 通义 / 硅基流动 均可）---
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat

# --- 模型兜底通道：本地 Ollama（可选，未启用 profile 时不生效）---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- 向量库：仍然不引入。向量索引建在进程内（几十个知识块，暴力余弦即可），
#     不需要 PGVector 容器，也不影响 MySQL/Redis/ES/RabbitMQ。
#     真要持久化/上量时再启用下面这组，并按方案放独立 compose profile ---
# PGVECTOR_HOST=localhost
# PGVECTOR_PORT=5432
# PGVECTOR_DB=zeroai_ai
# PGVECTOR_USER=zeroai
# PGVECTOR_PASSWORD=change_me_in_local_env

# --- AI 能力总开关（默认关闭，避免误触发生成费用）---
AI_ENABLED=false
# 引擎：spring-ai（单轮无工具问答） / agentscope（带只读商城工具的 Agent）
AI_ENGINE=spring-ai

# --- 写操作提议（Human-in-the-loop）---
# 打开后 Agent 多一个 propose_order 工具：只生成待确认提议，不会自己下单；
# 订单写入必须由用户在页面点「确认下单」后走 /ai/action/confirm/{proposalNo}
AI_ACTION_ENABLED=false
AI_ACTION_TTL_SECONDS=600
AI_ACTION_MAX_ITEMS=10

# --- 对话历史（落 ES，页面重进可回看）---
AI_HISTORY_ENABLED=true
AI_HISTORY_INDEX=zeroai_ai_chat

# --- 知识库（RAG）：政策文档随代码打包，启动时同步到独立 ES 索引 ---
AI_KNOWLEDGE_ENABLED=true
AI_KNOWLEDGE_INDEX=zeroai_ai_kb
# 启动时是否全量同步知识索引（关掉后需手工触发，用于排查同步相关问题）
AI_KNOWLEDGE_SYNC_ON_STARTUP=true
# 单次检索返回的最大片段数
AI_KNOWLEDGE_MAX_HITS=3

# --- 知识检索模式：bm25（默认，ES 倒排）/ vector（纯向量）/ hybrid（两路 RRF 融合）---
# bm25 不需要任何外部服务；改成 vector 或 hybrid 就必须配下面的 embedding
AI_KNOWLEDGE_MODE=bm25

# --- 向量化服务（OpenAI 兼容 /v1/embeddings）---
# 与对话模型是两套配置：DeepSeek 没有 embedding 接口，不能复用 LLM_API_KEY。
# 举例（任选其一，把 base-url 与 model 换成对应服务的值）：
#   阿里百炼   AI_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
#              AI_EMBEDDING_MODEL=text-embedding-v3   AI_EMBEDDING_DIMENSION=1024
#   硅基流动   AI_EMBEDDING_BASE_URL=https://api.siliconflow.cn
#              AI_EMBEDDING_MODEL=BAAI/bge-m3         AI_EMBEDDING_DIMENSION=1024
#   本地 Ollama AI_EMBEDDING_BASE_URL=http://127.0.0.1:11434
#              AI_EMBEDDING_MODEL=nomic-embed-text     AI_EMBEDDING_DIMENSION=768
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=text-embedding-v3
# 维度必须与模型实际返回一致，不一致会启动即报错（这是刻意的，维度错位最难排查）
AI_EMBEDDING_DIMENSION=1024
# 余弦相似度下限，与 BM25 的 min-score 量纲不同，不能互相套用
AI_KNOWLEDGE_VECTOR_MIN_SCORE=0.55
