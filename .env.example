# ===== AI Agent 接入所需环境变量（复制为 .env 后填入真实值，.env 不入库）=====

# --- 模型主通道：OpenAI 兼容协议（DeepSeek / 通义 / 硅基流动 均可）---
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat

# --- 模型兜底通道：本地 Ollama（可选，未启用 profile 时不生效）---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- 向量库：P6 知识库阶段才需要 ---
PGVECTOR_HOST=localhost
PGVECTOR_PORT=5432
PGVECTOR_DB=zeroai_ai
PGVECTOR_USER=zeroai
PGVECTOR_PASSWORD=change_me_in_local_env

# --- AI 能力总开关（默认关闭，避免误触发生成费用）---
AI_ENABLED=false
