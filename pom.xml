    <properties>
        <!-- 基线 JDK 21。产物 target 为 21，运行时必须是 JDK 21+，不能再回退到 17。
             配套要求：Lombok ≥ 1.18.30（当前 1.18.46）。 -->
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.4</maven-surefire-plugin.version>
        <!-- Spring Boot 4.1.x：Spring AI 2.0.x 的编译基线。Boot 4 拆分了 autoconfigure 模块、
             默认 Jackson 3、Spring Security 7，升级时必须三件套（Boot / Spring AI / Jackson）同批动。 -->
        <spring-boot.version>4.1.2</spring-boot.version>
        <!-- Spring AI 2.0.2 = 2.0 线最新稳定补丁版（官方要求 Boot 4.x）。
             2.1.x 目前只有 M1/RC，不上生产。 -->
        <spring-ai.version>2.0.2</spring-ai.version>
        <!-- Boot 4 的 BOM 已不再管理 spring-retry，必须自己钉版本 -->
        <spring-retry.version>2.0.13</spring-retry.version>
        <!-- 与 spring-ai-openai 2.0.2 传递的 openai-java-core 版本保持一致 -->
        <openai-java.version>4.80.0</openai-java.version>
        <mysql.connector.j.version>9.7.0</mysql.connector.j.version>
        <elasticsearch.version>7.17.29</elasticsearch.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <druid.version>1.2.28</druid.version>
        <!-- 与 spring-boot-dependencies 3.5.14 管理版本保持一致。
             1.18.26 不支持 JDK 21+（JCImport.qualid 改为 JCPath，注解处理器会抛 NoSuchFieldError），
             且同构建内不能混用两个 lombok 版本。 -->
        <lombok.version>1.18.46</lombok.version>
        <commons.io.version>2.22.0</commons.io.version>
        <commons.collections.version>4.5.0</commons.collections.version>
        <commons.fileupload.version>1.6.0</commons.fileupload.version>
        <commons-lang3.version>3.20.0</commons-lang3.version>
        <fastjson.version>2.0.62</fastjson.version>
        <easy-captcha.version>1.6.2</easy-captcha.version>
        <jwt.version>4.3.0</jwt.version>
        <qiniu.version>7.12.1</qiniu.version>
        <mail.version>2.0.2</mail.version>
        <hutool.version>5.8.46</hutool.version>
        <easyexcel.version>4.0.3</easyexcel.version>
        <weixin-java-pay.version>4.8.3-20260527.210905</weixin-java-pay.version>
        <alipay-sdk-java.version>4.40.828.ALL</alipay-sdk-java.version>
        <sms4j.version>3.3.5</sms4j.version>
        <sa-token.version>1.46.0</sa-token.version>
        <shedlock.version>5.16.0</shedlock.version>
        <protobuf-java.version>4.35.0</protobuf-java.version>
        <okhttp.version>4.12.0</okhttp.version>
        <okio.version>3.17.0</okio.version>
        <dom4j.version>2.2.0</dom4j.version>
        <bouncycastle.version>1.84</bouncycastle.version>
        <commons.compress.version>1.28.0</commons.compress.version>
        <log4j.version>2.26.0</log4j.version>
        <poi.version>5.5.1</poi.version>
        <lz4.version>1.8.1</lz4.version>
        <yawk-lz4.version>1.10.1</yawk-lz4.version>
        <tomcat.version>10.1.55</tomcat.version>
        <!-- AgentScope Java。Maven Central 的 <latest>/<release> 指向 2.1.0-BETA1，
            按 release 取会误装 beta，必须写死 2.0.4。升级前先跑 docs/agent/ADR-001 的兼容性检查。 -->
        <agentscope.version>2.0.4</agentscope.version>
        <!-- victools 版本仲裁：Spring AI 2.0.2 依赖 5.0.0，AgentScope 2.0.4 依赖 4.38.0，
             两个都是 compile 作用域且大版本不兼容（5.x 移除了 4.x 的 generateSchema 重载，
             运行时抛 NoSuchMethodError）。此处统一钉 4.38.0：
             AgentScope 的工具 schema 生成是活跃路径，必须可用；
             Spring AI 仅在结构化输出时用 victools，本项目 AI 通道不使用该特性。
             若将来要启用 Spring AI 的结构化输出，必须回头重新评估本仲裁，见 ADR-001。 -->
        <victools.version>4.38.0</victools.version>
    </properties>

